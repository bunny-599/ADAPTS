# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=adaptive_assessment
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_MAX=30
DATABASE_POOL_MIN=5
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECT_TIMEOUT=5000
DATABASE_SSL=false
# Optional full connection URL (e.g. for Render, Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Server & Security
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-secure-random-256-bit-string-for-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# LLM Providers (Google Gemini SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Web Research Engine (Tavily Search API)
TAVILY_API_KEY=your_tavily_api_key_here

# Code Execution Sandbox (Trial 13)
# 'mock': High-fidelity in-memory sandbox for local dev / testing without Docker
# 'docker': Isolated container sandbox with limits (--network none, --memory 256m, --cpus 0.5)
CODE_EXECUTION_SANDBOX=mock
CODE_EXECUTION_TIMEOUT_MS=3000
CODE_EXECUTION_MEMORY_MB=256
CODE_EXECUTION_OUTPUT_LIMIT_BYTES=65536
